PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bahrain-hrms
JWT_SECRET=generate_with: node -e "require('crypto').randomBytes(64,(e,b)=>console.log(b.toString('hex')))"
JWT_EXPIRE=7d
ENCRYPTION_KEY=32_character_encryption_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
NODE_ENV=development
# Local dev: comma-separated. On Render: set to your Render URL e.g. https://your-app.onrender.com
CORS_ORIGIN=http://localhost:5173
